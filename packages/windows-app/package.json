{
  "name": "localhostkiller-app",
  "productName": "Localhost Killer",
  "version": "0.1.0",
  "description": "Windows desktop app to kill processes listening on localhost ports.",
  "license": "MIT",
  "author": {
    "name": "localhostkiller contributors"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/localhostkiller.git",
    "directory": "packages/windows-app"
  },
  "main": "dist-main/main/main.js",
  "scripts": {
    "build:main": "node esbuild.main.js",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "dev:renderer": "vite",
    "dev:main": "node esbuild.main.js --watch",
    "dev": "node scripts/dev.js",
    "start": "electron .",
    "package": "npm run build && electron-builder --win nsis portable --config electron-builder.yml"
  },
  "devDependencies": {
    "@localhostkiller/core": "*",
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.2.1",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.21.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.3.4"
  }
}
