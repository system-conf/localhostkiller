{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "outDir": "dist-renderer",
    "rootDir": "src/renderer",
    "types": ["vite/client"],
    "declaration": false,
    "declarationMap": false,
    "noEmit": true
  },
  "include": ["src/renderer/**/*"]
}
